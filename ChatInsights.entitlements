<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	
	<!-- Network -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	
	<!-- Contacts Access -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	
	<!-- Calendar and Reminders Access -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	
	<!-- Location Services -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	
	<!-- File Access (for iMessage database) -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	
	<!-- Allow reading from user-selected files -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	
	<!-- Temporary exception to read home directory if needed -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Messages/</string>
	</array>
	
	<!-- User Notifications -->
	<key>com.apple.security.app-groups</key>
	<array>
		<string>group.com.chatinsights</string>
	</array>
</dict>
</plist>
